# Copy to .env and fill in YOUR OWN values. NEVER commit .env / .env.strategy.
# All values below are placeholders (or empty) — never paste real secrets
# into a chat, a model prompt, or a committed file.
#
# Strategy values (STRATEGY_PARAMS / STRATEGY_SALT / STRATEGY_COMMITMENT_HASH)
# are generated by `npm run commitment` into gitignored .env.strategy;
# config.js loads .env.strategy first, then .env, so the strategy file wins
# for those three keys. In production (VPS/Railway) set them as env vars.

# Port the agent listens on (Railway/VPS set PORT automatically).
PORT=3000

# HMAC secret shown ONCE by the platform when you register/rotate the agent
# secret on the Agent Games dashboard (My Agents -> Rotate Secret).
# The agent uses it to verify inbound requests AND to sign responses.
# Local testing only: any dummy value, e.g. test-hmac-secret-dummy-only.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key (get one from Kurier). Used to submit proofs for
# verification. Leave empty to skip on-chain submission; proof generation
# still runs locally and is self-verified.
KURIER_API_KEY=

# Kurier REST base URL (from the official Build page).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# The strategy-commitment hash shown in turn envelopes
# (strategyCommitment.hash). commitment = Poseidon(strategyParams, salt).
# If set, the agent HOLDs on any turn whose commitment hash does not match.
# Leave empty to skip the check (not recommended for scored rounds).
STRATEGY_COMMITMENT_HASH=

# The 8 strategy parameters the circuit enforces, as a JSON array.
# Default [10,0,0,0,0,0,0,0] = always EXTRACT 10 (simplest provable policy).
# [0] EXTRACT amount 1..10; [1] FORTIFY below this balance; [2] HOLD at/below
# this opponent balance; [3] 0/1 force HOLD; [4..7] must be 0.
STRATEGY_PARAMS=[10,0,0,0,0,0,0,0]

# Random salt for the commitment (31-byte hex, "0x...").
# Generate with `npm run commitment` — saved to gitignored .env.strategy
# and NEVER printed. Without it no proof can be generated.
STRATEGY_SALT=

# Circuit version for Steal the VFY. Must match your registered commitment.
CIRCUIT_VERSION=v1

# vk_hash of the vfy-policy circuit, registered on zkVerify mainnet.
# From https://agentgames.zkverify.io/api/circuit-info (also in
# circuits/circuit-info.json).
VK_HASH=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047

# Proof generation master switch. Default true: the agent generates +
# locally verifies a Groth16 policy proof per turn and submits it to
# Kurier when a key is set. Set PROOF_ENABLED=false to answer turns
# without a proof (the platform then scores the turn as HOLD).
PROOF_ENABLED=true

# Optional persistent idempotency store (JSON file, atomic tmp -> rename).
# Unset = memory only. On a host with a persistent volume (VPS /data),
# set e.g. IDEMPOTENCY_STORE_PATH=/data/idempotency.json so a platform
# retry after a restart still gets the identical cached response.
IDEMPOTENCY_STORE_PATH=
